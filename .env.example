# ==========================================
# Netlify Frontend Environment Variables
# (Configure in Netlify: Site configuration -> Environment variables)
# ==========================================
# Replace with your deployed Render backend URL (no trailing slash):
VITE_API_BASE_URL=https://neuroscan-backend.onrender.com

# ==========================================
# Render Backend Environment Variables
# (Configure in Render: Service -> Environment)
# ==========================================
# Optional: Comma-separated list of additional allowed origins if you use a custom domain.
# Note: Any https://*.netlify.app URL is automatically permitted by default.
ALLOWED_ORIGINS=https://your-custom-domain.com

# Python runtime version for Render
PYTHON_VERSION=3.11.9
